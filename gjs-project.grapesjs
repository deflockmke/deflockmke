//api.iconify.design/lucide-chevron-left.svg?color=%230f172a","alt":"Previous month"}}]}]},{"type":"button","name":"Next Month Button","attributes":{"type":"button","aria-label":"Next month","data-js":"calendar-next"},"components":[{"type":"contentEditable","components":[{"type":"image","name":"Next Month Icon","resizable":{"ratioDefault":1},"attributes":{"src":"https://api.iconify.design/lucide-chevron-right.svg?color=%230f172a","alt":"Next month"}}]}]}]}]},{"name":"Calendar Grid","classes":["calendar-grid"],"attributes":{"data-js":"calendar-grid"}},{"name":"Calendar Legend","classes":["calendar-legend"]}]},{"tagName":"aside","name":"Calendar Sidebar","classes":["calendar-side"],"components":[{"name":"Upcoming Events Card","classes":["calendar-side-card"],"components":[{"tagName":"h3","type":"heading","name":"Sidebar Title","classes":["calendar-side-title"],"components":[{"type":"textnode","content":"Upcoming events"}]},{"tagName":"p","type":"text","name":"Sidebar Description","classes":["calendar-side-text"],"components":[{"type":"textnode","content":"The next items from the public calendar are listed here for quick access."}]},{"name":"Upcoming Events List","classes":["calendar-list"],"attributes":{"data-js":"calendar-list"},"components":[{"name":"Upcoming Event Item","classes":["calendar-list-item"],"components":[{"type":"text","name":"Upcoming Event Date","classes":["calendar-list-date"],"components":[{"type":"textnode","content":"Loading"}]},{"type":"text","name":"Upcoming Event Name","classes":["calendar-list-name"],"components":[{"type":"textnode","content":"Fetching upcoming events from the calendar feed…"}]},{"type":"text","name":"Upcoming Event Meta","classes":["calendar-list-meta"],"components":[{"type":"textnode","content":"Please wait a moment."}]}]}]}]},{"name":"Calendar Feed Card","classes":["calendar-side-card"],"components":[{"tagName":"h3","type":"heading","name":"Sidebar Title","classes":["calendar-side-title"],"components":[{"type":"textnode","content":"Calendar feed"}]},{"tagName":"p","type":"text","name":"Sidebar Description","classes":["calendar-side-text"],"components":[{"type":"textnode","content":"Use this public ICS link in Proton Calendar, Apple Calendar, Google Calendar, Outlook, or most scheduling apps."}]},{"name":"Feed Box","classes":["calendar-feed"],"components":[{"type":"text","name":"Feed Label","classes":["calendar-feed-label"],"components":[{"type":"textnode","content":"Public ICS URL"}]},{"type":"link","name":"Feed Link","classes":["calendar-feed-link","gjs-t-link"],"attributes":{"href":"https://calendar.proton.me/api/calendar/v1/url/WNTl_CDI10oEGuU7TxBe8-2YHLbL30Zow6T7EA7YrHQuXkq4XQOC3XLzmKvRQNLlEGEBtInQjrrfU8q5JqJsrA==/calendar.ics?CacheKey=AJ5NiQYTv9_jv1oI_4jhBQ%3D%3D&PassphraseKey=LqCyjfw10MnyPY2EdgLNFKeTgiX2FnTH-fLbVWZjUWo%3D","target":"_blank","rel":"noopener noreferrer"},"components":[{"type":"textnode","content":"https://calendar.proton.me/api/calendar/v1/url/.../calendar.ics"}]}]}]}]}]}]},{"type":"script","attributes":{"data-scope":"calendar-widget"},"components":[{"type":"textnode","content":"\n(function(){\n  const root = document.querySelector('[data-js=\"calendar-widget\"]');\n  if(!root) return;\n\n  const feedUrl = 'https://calendar.proton.me/api/calendar/v1/url/WNTl_CDI10oEGuU7TxBe8-2YHLbL30Zow6T7EA7YrHQuXkq4XQOC3XLzmKvRQNLlEGEBtInQjrrfU8q5JqJsrA==/calendar.ics?CacheKey=AJ5NiQYTv9_jv1oI_4jhBQ%3D%3D&PassphraseKey=LqCyjfw10MnyPY2EdgLNFKeTgiX2FnTH-fLbVWZjUWo%3D';\n  const monthLabel = root.querySelector('[data-js=\"calendar-month-label\"]');\n  const grid = root.querySelector('[data-js=\"calendar-grid\"]');\n  const list = root.querySelector('[data-js=\"calendar-list\"]');\n  const status = root.querySelector('[data-js=\"calendar-status\"]');\n  const prev = root.querySelector('[data-js=\"calendar-prev\"]');\n  const next = root.querySelector('[data-js=\"calendar-next\"]');\n\n  let currentMonth = new Date();\n  currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), 1);\n  let events = [];\n\n  function escapeHtml(str){\n    return String(str || '').replace(/[&<>\"']/g, function(m){\n      return ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[m];\n    });\n  }\n\n  function unfoldICS(text){\n    return text.replace(/\\r?\\n[ \\t]/g, '');\n  }\n\n  function parseICSDate(value){\n    if(!value) return null;\n    const clean = value.trim();\n    if(/^\\d{8}$/.test(clean)){\n      const y = parseInt(clean.slice(0,4),10);\n      const m = parseInt(clean.slice(4,6),10) - 1;\n      const d = parseInt(clean.slice(6,8),10);\n      return new Date(y,m,d);\n    }\n    if(/^\\d{8}T\\d{6}Z$/.test(clean)){\n      const y = parseInt(clean.slice(0,4),10);\n      const m = parseInt(clean.slice(4,6),10) - 1;\n      const d = parseInt(clean.slice(6,8),10);\n      const h = parseInt(clean.slice(9,11),10);\n      const min = parseInt(clean.slice(11,13),10);\n      const s = parseInt(clean.slice(13,15),10);\n      return new Date(Date.UTC(y,m,d,h,min,s));\n    }\n    if(/^\\d{8}T\\d{6}$/.test(clean)){\n      const y = parseInt(clean.slice(0,4),10);\n      const m = parseInt(clean.slice(4,6),10) - 1;\n      const d = parseInt(clean.slice(6,8),10);\n      const h = parseInt(clean.slice(9,11),10);\n      const min = parseInt(clean.slice(11,13),10);\n      const s = parseInt(clean.slice(13,15),10);\n      return new Date(y,m,d,h,min,s);\n    }\n    const dt = new Date(clean);\n    return isNaN(dt.getTime()) ? null : dt;\n  }\n\n  function parseICS(text){\n    const lines = unfoldICS(text).split(/\\r?\\n/);\n    const items = [];\n    let current = null;\n\n    lines.forEach(function(line){\n      if(line === 'BEGIN:VEVENT'){\n        current = {};\n        return;\n      }\n      if(line === 'END:VEVENT'){\n        if(current) items.push(current);\n        current = null;\n        return;\n      }\n      if(!current) return;\n\n      const splitIndex = line.indexOf(':');\n      if(splitIndex === -1) return;\n      const rawKey = line.slice(0, splitIndex);\n      const value = line.slice(splitIndex + 1);\n      const key = rawKey.split(';')[0];\n\n      if(key === 'SUMMARY') current.summary = value.replace(/\\\\,/g, ',').replace(/\\\\n/g, ' ');\n      if(key === 'LOCATION') current.location = value.replace(/\\\\,/g, ',').replace(/\\\\n/g, ' ');\n      if(key === 'DESCRIPTION') current.description = value.replace(/\\\\n/g, ' ');\n      if(key === 'DTSTART') current.start = parseICSDate(value);\n      if(key === 'DTEND') current.end = parseICSDate(value);\n      if(key === 'URL') current.url = value;\n    });\n\n    return items.filter(function(item){\n      return item.start instanceof Date && !isNaN(item.start.getTime()) && item.summary;\n    }).sort(function(a,b){\n      return a.start - b.start;\n    });\n  }\n\n  function isSameDay(a,b){\n    return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();\n  }\n\n  function formatMonth(date){\n    return date.toLocaleDateString(undefined,{month:'long',year:'numeric'});\n  }\n\n  function formatListDate(date){\n    return date.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});\n  }\n\n  function formatTime(date){\n    const midnight = date.getHours() === 0 && date.getMinutes() === 0;\n    if(midnight) return 'All day';\n    return date.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'});\n  }\n\n  function eventsForDay(date){\n    return events.filter(function(item){\n      const start = new Date(item.start);\n      const end = item.end ? new Date(item.end) : new Date(item.start);\n      const dayStart = new Date(date.getFullYear(), date.getMonth(), date.getDate(), 0, 0, 0);\n      const dayEnd = new Date(date.getFullYear(), date.getMonth(), date.getDate(), 23, 59, 59);\n      return start <= dayEnd && end >= dayStart;\n    });\n  }\n\n  function renderGrid(){\n    monthLabel.textContent = formatMonth(currentMonth);\n    grid.innerHTML = '';\n\n    ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(function(day){\n      const el = document.createElement('div');\n      el.className = 'calendar-dow';\n      el.textContent = day;\n      grid.appendChild(el);\n    });\n\n    const firstDay = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), 1);\n    const startOffset = firstDay.getDay();\n    const startDate = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), 1 - startOffset);\n    const today = new Date();\n\n    for(let i = 0; i < 42; i++){\n      const date = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate() + i);\n      const dayEvents = eventsForDay(date);\n      const cell = document.createElement('div');\n      let cls = 'calendar-day';\n      if(date.getMonth() !== currentMonth.getMonth()) cls += ' calendar-day-muted';\n      if(isSameDay(date, today)) cls += ' calendar-day-today';\n      cell.className = cls;\n\n      const dateBadge = document.createElement('div');\n      dateBadge.className = 'calendar-date';\n      dateBadge.textContent = date.getDate();\n      cell.appendChild(dateBadge);\n\n      if(dayEvents.length){\n        dayEvents.slice(0,2).forEach(function(item, idx){\n          const eventEl = document.createElement('div');\n          eventEl.className = idx % 2 === 0 ? 'calendar-event' : 'calendar-event calendar-event-accent';\n          eventEl.textContent = item.summary;\n          eventEl.title = item.summary + ' • ' + formatTime(item.start) + (item.location ? ' • ' + item.location : '');\n          cell.appendChild(eventEl);\n        });\n        if(dayEvents.length > 2){\n          const more = document.createElement('div');\n          more.className = 'calendar-empty';\n          more.textContent = '+' + (dayEvents.length - 2) + ' more';\n          cell.appendChild(more);\n        }\n      } else {\n        const empty = document.createElement('div');\n        empty.className = 'calendar-empty';\n        empty.textContent = 'No events';\n        cell.appendChild(empty);\n      }\n\n      grid.appendChild(cell);\n    }\n  }\n\n  function renderList(){\n    const now = new Date();\n    const upcoming = events.filter(function(item){\n      return item.start >= new Date(now.getTime() - 24 * 60 * 60 * 1000);\n    }).slice(0,6);\n\n    if(!upcoming.length){\n      list.innerHTML = '<div class=\"calendar-list-item\"><div class=\"calendar-list-date\">No upcoming items</div><div class=\"calendar-list-name\">The feed is active, but there are no future events yet.</div><div class=\"calendar-list-meta\">Check back soon or subscribe to receive updates automatically.</div></div>';\n      return;\n    }\n\n    list.innerHTML = upcoming.map(function(item){\n      const meta = [formatTime(item.start), item.location].filter(Boolean).join(' • ');\n      const title = escapeHtml(item.summary);\n      const date = escapeHtml(formatListDate(item.start));\n      const details = escapeHtml(meta || 'Details will appear in your calendar app');\n      const hrefStart = item.url ? '<a class=\"gjs-t-link\" href=\"' + escapeHtml(item.url) + '\" target=\"_blank\" rel=\"noopener noreferrer\">' : '';\n      const hrefEnd = item.url ? '</a>' : '';\n      return '<div class=\"calendar-list-item\">' +\n        '<div class=\"calendar-list-date\">' + date + '</div>' +\n        '<div class=\"calendar-list-name\">' + hrefStart + title + hrefEnd + '</div>' +\n        '<div class=\"calendar-list-meta\">' + details + '</div>' +\n      '</div>';\n    }).join('');\n  }\n\n  function setStatus(message){\n    status.textContent = message;\n  }\n\n  prev.addEventListener('click', function(){\n    currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() - 1, 1);\n    renderGrid();\n  });\n\n  next.addEventListener('click', function(){\n    currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1);\n    renderGrid();\n  });\n\n  fetch(feedUrl)\n    .then(function(res){\n      if(!res.ok) throw new Error('Feed request failed');\n      return res.text();\n    })\n    .then(function(text){\n      events = parseICS(text);\n      renderGrid();\n      renderList();\n      if(events.length){\n        setStatus('Live calendar loaded successfully. Browse months to view scheduled community events.');\n      } else {\n        setStatus('The feed loaded, but no events were found yet. Use the subscription link to stay informed.');\n      }\n    })\n    .catch(function(){\n      renderGrid();\n      renderList();\n      setStatus('The live feed could not be loaded in this browser. Please use the buttons above to open or subscribe to the public calendar directly.');\n    });\n\n  renderGrid();\n})();\n"}]}]}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"title","type":"text","components":[{"type":"textnode","content":"Home"}]},{"tagName":"meta","void":true,"attributes":{"charset":"UTF-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1.0"}},{"tagName":"meta","void":true,"attributes":{"name":"robots","content":"index,follow"}},{"tagName":"meta","void":true,"attributes":{"name":"generator","content":"GrapesJS Studio"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.googleapis.com"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","attributes":{"lang":"en"}}},"id":"9btsn8MANzXj73IB","minHeight":"500px"}],"id":"ld75T94bCi8f5q1kPJCb"}],"symbols":[{"name":"Logo Mark","classes":["logo-mark"],"attributes":{"__nc":"","id":"i8ngh"},"__symbols":[],"components":[{"tagName":"span","type":"text","name":"Logo Text","classes":["font-heading","font-800","logo-text"],"attributes":{"id":"ivcur"},"__symbols":[],"components":[{"type":"textnode","content":"C","attributes":{"id":"if76j"},"__symbols":[]}]},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmtib88uj56y0r1of6hgdwlik/assets/83a4d165-1053-40d2-845e-b091fcca585f__deflockmilwaukee.png","id":"ibc6e"},"__symbols":[]}]}],"custom":{"projectType":"web","id":"landingProject"}}